<?xml version="1.0" encoding="utf-8"?>
<!-- 不参与云备份 / 设备迁移：令牌与本机 Key 绑定设备 Keystore，迁移后无法解密，反而会造成「已登录但全 401」。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
