# Host port matches docker-compose.yml (54102:5432). If you map 5432:5432, use 5432 here.
DATABASE_URL=postgresql+asyncpg://vnss:vnss@localhost:54102/vnss
SECRET_KEY=change-me-to-a-long-random-string
# 60 min access token (leaked JWT dies fast); refresh token carries the session
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HTTPS 上线后置 true：让登录刷新 Cookie 只在 TLS 上传输
# COOKIE_SECURE=true

# 网站页脚备案号（ICP 备案通过后填写 ICP_BEIAN_NUMBER；公安备案通过后再填 GONGAN_BEIAN_NUMBER）。
# 未填写则页脚只显示「使用指南」，不显示备案链接。
# ICP_BEIAN_NUMBER=
# GONGAN_BEIAN_NUMBER=

# LLM — server-only; frontend never sends keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# openai (default) | ollama — or just point DEEPSEEK_BASE_URL at http://localhost:11434
LLM_PROVIDER=openai

# Agent 写作上下文主预算（字符数）。默认 12000 是成本/质量平衡值；想试更大
# 就调大（每次请求输入 token 随之线性变多：费用/耗时/免费档限流都受影响）。
# 跨章"记住整本书"靠检索+滚动记忆，不是靠单次窗口拉大。
# AGENT_CONTEXT_MAX_CHARS=12000

# Agent craft / self-review (auto | off | lite | full) / (auto | on | off)
AGENT_CRAFT_MODE=auto
AGENT_SELF_REVIEW=auto

# Optional separate critic model (leave empty to reuse writer)
CRITIC_API_KEY=
CRITIC_API_BASE_URL=
CRITIC_API_MODEL=

# Optional Fernet key for leftover encrypted columns (not used by settings UI)
SETTINGS_FERNET_KEY=

# Optional: multi-worker SSE + rate-limit bridge (leave empty = single-worker in-process).
# REDIS_URL=redis://localhost:6379/0

# LLM quota. 0 = unlimited for users who bring their own Key.
# LLM_DAILY_TOKEN_CAP=0
# Cap only when falling through to the *server* DEEPSEEK_API_KEY (anti-drain).
# LLM_SHARED_KEY_DAILY_CAP=200000

# Storage anti-abuse (generous).
# MAX_PROJECTS_PER_USER=80

# Kill switch for sign-ups.
# ALLOW_REGISTRATION=true

# Admin bootstrap when DB has zero admins.
# - Set to your username on first deploy, OR leave empty so the first login
#   is auto-promoted (useful for local). After that, grant/revoke in the UI.
# ADMIN_USERNAMES=yourname
ADMIN_USERNAMES=
# Resend — email verify / password reset (https://resend.com)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@send.vnscriptstudio.cn
# PUBLIC_APP_URL=http://vnscriptstudio.cn

# Optional pgvector semantic search (OpenAI-compatible embeddings endpoint).
# Requires postgres image pgvector/pgvector:pg16 + `CREATE EXTENSION vector`.
# Leave empty to keep heuristic keyword search.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# Moegirlpedia lore lookup (self-use; CC BY-NC-SA — distill, don't dump wiki into scripts)
MOEGIRL_ENABLED=true
MOEGIRL_API_BASE=https://zh.moegirl.org.cn/api.php
MOEGIRL_USER_AGENT=VNScriptStudio/0.1 (self-use writing aid; +https://github.com/Saltedfish20060409/vn-script-studio)
