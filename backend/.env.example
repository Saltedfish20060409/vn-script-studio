# Host port matches docker-compose.yml (54102:5432). If you map 5432:5432, use 5432 here.
DATABASE_URL=postgresql+asyncpg://vnss:vnss@localhost:54102/vnss
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM — server-only; frontend never sends keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# openai (default) | ollama — or just point DEEPSEEK_BASE_URL at http://localhost:11434
LLM_PROVIDER=openai

# Agent craft / self-review (auto | off | lite | full) / (auto | on | off)
AGENT_CRAFT_MODE=auto
AGENT_SELF_REVIEW=auto

# Optional separate critic model (leave empty to reuse writer)
CRITIC_API_KEY=
CRITIC_API_BASE_URL=
CRITIC_API_MODEL=

# Optional Fernet key for leftover encrypted columns (not used by settings UI)
SETTINGS_FERNET_KEY=

# Optional: multi-worker SSE bridge (leave empty = single-worker in-process).
# With uvicorn --workers N, set this so lock/member/comment events cross workers.
# REDIS_URL=redis://localhost:6379/0

# Moegirlpedia lore lookup (self-use; CC BY-NC-SA — distill, don't dump wiki into scripts)
MOEGIRL_ENABLED=true
MOEGIRL_API_BASE=https://zh.moegirl.org.cn/api.php
MOEGIRL_USER_AGENT=VNScriptStudio/0.1 (self-use writing aid; +https://github.com/Saltedfish20060409/vn-script-studio)
