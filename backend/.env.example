DATABASE_URL=postgresql+asyncpg://vnss:vnss@localhost:5432/vnss
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM — server-only; frontend never sends keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Agent craft / self-review (auto | off | lite | full) / (auto | on | off)
AGENT_CRAFT_MODE=auto
AGENT_SELF_REVIEW=auto

# Optional separate critic model (leave empty to reuse writer)
CRITIC_API_KEY=
CRITIC_API_BASE_URL=
CRITIC_API_MODEL=

# Optional Fernet key for leftover encrypted columns (not used by settings UI)
SETTINGS_FERNET_KEY=
